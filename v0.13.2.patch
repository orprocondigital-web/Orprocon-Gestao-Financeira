+function addXmlText(name, text){
+  let statusEl = logFile(name, 'processando…', null);
+  try{
+    const parser = new DOMParser();
+    const doc = parser.parseFromString(text, 'text/xml');
+    const res = parseXmlDoc(doc, name);
+    if(res.error && res.items.length===0){
+      updateFileLog(statusEl, res.error, false);
+    } else {
+      allRows = allRows.concat(res.items);
+      updateFileLog(statusEl, res.items.length + ' item(ns) encontrados', true);
+      render();
+    }
+  }catch(err){
+    updateFileLog(statusEl, 'Erro ao processar: ' + err.message, false);
+  }
+}
+
+// ---------------- Dados de exemplo (fictícios) ----------------
+// Notas montadas para demonstrar cada situação da conferência: itens corretos,
+// redução de alíquota (gRed), valores divergentes, cClassTrib ausente,
+// item sem o grupo IBSCBS, CST sem incidência e uma NFS-e.
+// Alíquotas do ano-teste de 2026: CBS 0,9% e IBS 0,1% (UF).
+function gerarExemploIbsCbs(){
+  const r2 = v=>Math.round(v*100)/100;
+  const f2 = v=>v.toFixed(2), f4 = v=>v.toFixed(4);
+  const EMIT = {cnpj:'11222333000181', nome:'Comercial Exemplo Ltda'};
+  const DEST = {cnpj:'44555666000177', nome:'Mercado Bom Preço Ltda'};
+
+  // grupo IBSCBS; "erro" força divergência em um dos valores
+  function grupo(it){
+    if(it.semGrupo) return '';
+    const cls = it.cClassTrib ? `<cClassTrib>${it.cClassTrib}</cClassTrib>` : '';
+    if(it.semBC) return `<IBSCBS><CST>${it.cst}</CST>${cls}</IBSCBS>`;
+    const bc = it.v, red = it.red || 0;
+    const ef = p=>r2(p*(1-red/100)*10000)/10000;
+    const gRed = p=> (red && p) ? `<gRed><pRedAliq>${f4(red)}</pRedAliq><pAliqEfet>${f4(ef(p))}</pAliqEfet></gRed>` : '';
+    const pUf = 0.1, pMun = 0, pCbs = 0.9;
+    let vUf = r2(bc*ef(pUf)/100), vMun = r2(bc*ef(pMun)/100), vCbs = r2(bc*ef(pCbs)/100);
+    if(it.erro==='cbs') vCbs = r2(bc*pCbs/100);          // ignorou a redução
+    if(it.erro==='uf') vUf = r2(vUf*1.5);                 // alíquota errada
+    let vIbs = r2(vUf+vMun);
+    if(it.erro==='total') vIbs = r2(vIbs+1.37);           // soma não fecha
+    return `<IBSCBS><CST>${it.cst}</CST>${cls}<gIBSCBS><vBC>${f2(bc)}</vBC>`+
+      `<gIBSUF><pIBSUF>${f4(pUf)}</pIBSUF>${gRed(pUf)}<vIBSUF>${f2(vUf)}</vIBSUF></gIBSUF>`+
+      `<gIBSMun><pIBSMun>${f4(pMun)}</pIBSMun>${gRed(pMun)}<vIBSMun>${f2(vMun)}</vIBSMun></gIBSMun>`+
+      `<vIBS>${f2(vIbs)}</vIBS>`+
+      `<gCBS><pCBS>${f4(pCbs)}</pCBS>${gRed(pCbs)}<vCBS>${f2(vCbs)}</vCBS></gCBS></gIBSCBS></IBSCBS>`;
+  }
+  function nfe(n, itens){
+    const dets = itens.map((it,i)=>{
+      const q = it.q || 1;
+      return `<det nItem="${i+1}"><prod><cProd>${it.cod}</cProd><xProd>${it.x}</xProd><NCM>${it.ncm}</NCM><CFOP>${it.cfop||'5102'}</CFOP>`+
+        `<qCom>${f4(q)}</qCom><vUnCom>${f4(it.v/q)}</vUnCom><vProd>${f2(it.v)}</vProd></prod><imposto>${grupo(it)}</imposto></det>`;
+    }).join('');
+    return `<?xml version="1.0" encoding="UTF-8"?><nfeProc xmlns="http://www.portalfiscal.inf.br/nfe" versao="4.00"><NFe><infNFe versao="4.00">`+
+      `<ide><mod>55</mod><serie>1</serie><nNF>${n}</nNF><dhEmi>2026-09-15T10:00:00-03:00</dhEmi></ide>`+
+      `<emit><CNPJ>${EMIT.cnpj}</CNPJ><xNome>${EMIT.nome}</xNome></emit><dest><CNPJ>${DEST.cnpj}</CNPJ><xNome>${DEST.nome}</xNome></dest>`+
+      `${dets}</infNFe></NFe></nfeProc>`;
+  }
+  const nfse = `<?xml version="1.0" encoding="UTF-8"?><NFSe><infNFSe><nNFSe>2381</nNFSe><DPS><infDPS><serv>`+
+    `<cServ><xDescServ>Consultoria contábil mensal</xDescServ></cServ></serv><valores><trib>`+
+    grupo({cst:'000', cClassTrib:'000001', v:3500}) + `</trib></valores></infDPS></DPS></infNFSe></NFSe>`;
+
+  return [
+    {name:'exemplo-nfe-1001.xml', text: nfe(1001, [
+      {cod:'ARZ5', x:'Arroz tipo 1 5kg', ncm:'10063021', q:20, v:579.80, cst:'000', cClassTrib:'000001'},
+      {cod:'OLE9', x:'Óleo de soja 900ml', ncm:'15079011', q:24, v:191.76, cst:'000', cClassTrib:'000001'},
+      {cod:'REF2', x:'Refrigerante 2L', ncm:'22021000', q:12, v:107.88, cst:'000', cClassTrib:'000001'}
+    ])},
+    {name:'exemplo-nfe-1002.xml', text: nfe(1002, [
+      {cod:'LIV1', x:'Livro didático — Matemática 6º ano', ncm:'49011000', q:10, v:890.00, cst:'200', cClassTrib:'200028', red:60},
+      {cod:'MED7', x:'Medicamento genérico cx 30 comp.', ncm:'30049099', q:15, v:412.50, cst:'200', cClassTrib:'200029', red:60, erro:'cbs'}
+    ])},
+    {name:'exemplo-nfe-1003.xml', text: nfe(1003, [
+      {cod:'CAF5', x:'Café torrado 500g', ncm:'09012100', q:30, v:629.70, cst:'000', cClassTrib:'000001', erro:'uf'},
+      {cod:'ACU1', x:'Açúcar cristal 1kg', ncm:'17019900', q:40, v:183.60, cst:'000', erro:'total'},
+      {cod:'BIS2', x:'Biscoito recheado 140g', ncm:'19053100', q:48, v:153.60, cst:'000'}
+    ])},
+    {name:'exemplo-nfe-1004.xml', text: nfe(1004, [
+      {cod:'EXP1', x:'Soja em grãos — exportação', ncm:'12019000', cfop:'7101', q:1000, v:2450.00, cst:'410', cClassTrib:'410004', semBC:true},
+      {cod:'ANT9', x:'Mercadoria em nota de layout antigo', ncm:'39269090', q:5, v:75.00, semGrupo:true}
+    ])},
+    {name:'exemplo-nfse-2381.xml', text: nfse}
+  ];
+}
+function carregarExemplo(){
+  allRows = [];
+  document.getElementById('filelist').innerHTML = '';
+  document.getElementById('toolbar').style.display = 'flex';
+  gerarExemploIbsCbs().forEach(f=>addXmlText(f.name, f.text));
+}
+document.getElementById('btnDemo').addEventListener('click', carregarExemplo);
+document.getElementById('btnDemo2').addEventListener('click', carregarExemplo);
+
